{
  "functions": {
    "api/deploy.js": {
      "maxDuration": 10
    },
    "api/health.js": {
      "maxDuration": 5
    }
  },
  "rewrites": [
    {
      "source": "/api/deploy",
      "destination": "/api/deploy.js"
    },
    {
      "source": "/api/health", 
      "destination": "/api/health.js"
    }
  ]
}
